{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://macpaw.github.io/portable-memory/schemas/episode.schema.json",
  "title": "Portable Memory episode",
  "description": "items/episode.jsonl — the atomic, cross-vendor memory. Enum-like fields are open strings for vendor neutrality. additionalProperties is TRUE: foreign (ext) fields round-trip verbatim.",
  "type": "object",
  "required": ["id", "eventTime", "mentionTime", "ingestionTime", "sourceType", "actors", "summary", "details", "sensitivity", "metadata", "categories", "importance", "confidence", "lifecycleState", "extractionState", "accessCount", "pinned", "vaultRefs"],
  "properties": {
    "id": { "type": "string", "description": "globally unique, stable, kind-prefixed (e.g. ep_…)" },
    "eventTime": { "type": "string", "format": "date-time", "description": "when it happened" },
    "mentionTime": { "type": "string", "format": "date-time", "description": "when it was stated/referenced" },
    "ingestionTime": { "type": "string", "format": "date-time", "description": "when it was stored" },
    "sourceType": { "type": "string" },
    "sourceID": { "type": ["string", "null"] },
    "actors": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" },
    "details": { "type": "string" },
    "sensitivity": { "type": "string" },
    "deletedAt": { "type": ["string", "null"], "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": { "type": "string" } },
    "contextID": { "type": ["string", "null"] },
    "categories": { "type": "array", "items": { "type": "string" } },
    "importance": { "type": "number" },
    "confidence": { "type": "number" },
    "lifecycleState": { "type": "string" },
    "extractionState": { "type": "string" },
    "lastAccessed": { "type": ["string", "null"], "format": "date-time" },
    "accessCount": { "type": "integer", "minimum": 0 },
    "pinned": { "type": "boolean" },
    "expirationDate": { "type": ["string", "null"], "format": "date-time" },
    "vaultRefs": { "type": "array", "items": { "type": "string" } },
    "speaker": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
